{
  "dependencies": {
    "@cap-js/postgres": "^3.0.1",
    "@cap-js/sqlite": "^3.0.2",
    "@sap/cds": "^10.0.4",
    "express": "^5.2.1",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@sap/cds-dk": "^10.0.6"
  },
  "scripts": {
    "copy-custom-lib": "cp -R lib gen/srv/lib && mkdir -p gen/srv/db/tenant && cp -R db/tenant/. gen/srv/db/tenant/",
    "start": "cds-serve"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "postgres",
        "pool": {
          "acquireTimeoutMillis": 10000
        }
      },
      "auth": {
        "kind": "custom",
        "impl": "lib/auth/middleware.js",
        "restrict_all_services": false
      }
    },
    "server": {
      "cors": false
    }
  }
}
